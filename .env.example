# Environment Configuration Example
# Copy this file to .env and update the values for your environment

# Azure Functions API URL
# Replace with your Azure Functions backend URL
# Example: https://your-function-app.azurewebsites.net/api
REACT_APP_API_URL=https://your-azure-function-app.azurewebsites.net/api

# Azure OpenAI Configuration (for backend Azure Functions)
# These are configured in FunctionApp/local.settings.json for local development
# and as Application Settings in Azure for production
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
